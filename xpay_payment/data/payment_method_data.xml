        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">none</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.ae'), ref('base.sa')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.AED'), ref('base.SAR')])]"/>
    </record>

    <record id="payment_method_tamara" model="payment.method">
